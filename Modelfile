FROM phi4-mini

TEMPLATE """{{- if .Messages }}
{{- if or .System .Tools }}<|system|>
{{- if .System }}{{ .System }}{{ end }}
{{- if .Tools }}
Use the following rule to decide when to call a function:
* if you need external information that can be obtained by calling one or more of the provided functions, generate a function call.

If you decide to call functions:
* prefix function calls with functools marker (no closing marker required)
* all function calls should be generated in a single JSON list formatted as functools[{"name": [function name], "arguments": [function arguments as JSON]}, ...]
* follow the provided JSON schema. Do not hallucinate arguments or values.
Available functions as JSON spec:
{{ .Tools }}
{{- end }}<|end|>
{{- end }}
{{- range $i, $_ := .Messages }}
{{- $last := eq (len (slice $.Messages $i)) 1 -}}
{{- if ne .Role "system" }}<|{{ .Role }}|>
{{- if and .Content (eq .Role "tool") }}
{"result": {{ .Content }}}
{{- else if .Content }}
{{ .Content }}
{{- else if .ToolCalls }}
functools[{{ range .ToolCalls }}{"name": "{{ .Function.Name }}", "arguments": {{ .Function.Arguments }}}{{ end }}]
{{- end }}<|end|>
{{- end }}
{{- if and (ne .Role "assistant") $last }}<|assistant|>{{ end }}
{{- end }}
{{- else }}
{{- if .System }}<|system|>
{{ .System }}<|end|>{{ end }}
{{- if .Prompt }}<|user|>
{{ .Prompt }}<|end|>{{ end }}<|assistant|>
{{- end }}"""
